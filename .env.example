# Database Configuration
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For local: postgresql://postgres:postgres@localhost:5432/medikiosk
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medikiosk

# Backend API URL (FastAPI)
# Development: http://localhost:8000/api/v1
# Production: https://your-backend-domain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Server-side backend URL (optional, for API routes)
BACKEND_URL=http://localhost:8000/api/v1

# Application Configuration
NEXT_PUBLIC_APP_NAME=MediKiosk
NEXT_PUBLIC_APP_VERSION=1.0.0

# Kiosk Configuration (optional - can be set per kiosk)
# NEXT_PUBLIC_KIOSK_ID=demo-kiosk-001
# NEXT_PUBLIC_KIOSK_BRANCH=allopathy

# Feature Flags (optional)
# NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
# NEXT_PUBLIC_ENABLE_VOICE_DETECTION=true
# NEXT_PUBLIC_ENABLE_DOCUMENT_UPLOAD=true

# Security (optional - for production)
# NEXTAUTH_SECRET=your-secret-key-here
# NEXTAUTH_URL=https://your-domain.com

# Analytics (optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# Debug Mode (set to 'true' for verbose logging)
# NEXT_PUBLIC_DEBUG=false
