# Copy this file to `.env` and fill in real values for local development.
# NEVER commit a `.env` file with real credentials.

# --- Application -----------------------------------------------------------
APP_ENV=development
APP_NAME=MediKiosk Backend
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Supabase / Postgres ------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# --- ABDM (Ayushman Bharat Digital Mission) ---
# Sandbox: https://sandbox.abdm.gov.in
# Production: https://abdm.gov.in  
# Requires onboarding at https://sandbox.abdm.gov.in/applications/Home/register
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_ENABLED=false

# --- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# --- Google Cloud Vision ---------------------------------------------------------
# Path to a service-account JSON credentials file (never commit the file itself).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-vision-service-account.json

# --- Auth / JWT -----------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Staff-only demo OTP ------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Dev/demo only: logs the OTP to the console instead of sending SMS.
# MUST be false in production.
OTP_LOG_TO_CONSOLE=true

# --- Rate limiting -----------------------------------------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Uploads -------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,application/pdf

# --- CORS ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
 
 # --- Bhashini Speech ---
# Obtain credentials from https://bhashini.gov.in
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_TIMEOUT_SECONDS=30