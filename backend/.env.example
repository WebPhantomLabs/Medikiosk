# Copy this file to `.env` and fill in real values for local development.
# NEVER commit a `.env` file with real credentials.

# --- Application -----------------------------------------------------------
APP_ENV=development
APP_NAME=MediKiosk Backend
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Supabase / Postgres ------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# --- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# --- Google Cloud Vision ---------------------------------------------------------
# Path to a service-account JSON credentials file (never commit the file itself).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-vision-service-account.json

# --- Auth / JWT -----------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Staff-only demo OTP ------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Dev/demo only: logs the OTP to the console instead of sending SMS.
# MUST be false in production.
OTP_LOG_TO_CONSOLE=true

# --- Rate limiting -----------------------------------------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Uploads -------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,application/pdf

# --- CORS ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
